{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.scale-encounter-gpu.config.ts",
    "playwright.readme-screenshots.config.ts",
    "playwright.review.config.ts",
    "eslint.config.js",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "review-e2e/**/*.ts"
  ]
}
