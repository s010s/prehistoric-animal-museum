{
  "name": "prehistoric-animal-museum",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "review": "npm run validate:review && vite --mode review",
    "build": "npm run validate:content && npm run validate:model-previews && tsc -b && tsx scripts/build-static-site.ts && npm run validate:production-boundary",
    "build:readme-screenshots": "vite build --mode model-still",
    "build:cloudflare": "npm run build:cloudflare:assets",
    "build:cloudflare:assets": "npm run build && node scripts/prepare-cloudflare-pages.mjs",
    "build:e2e": "npm run validate:content && tsc -b && tsx scripts/build-static-site.ts --mode e2e",
    "postbuild:e2e": "node scripts/sync-local-preview-4190.mjs",
    "preview": "node server.mjs dist",
    "lint": "eslint . --max-warnings=0",
    "optimize:models": "node scripts/optimize-runtime-models.mjs",
    "repair:scale-encounter-models": "node scripts/repair-scale-encounter-model-animations.mjs",
    "generate:model-previews": "tsx scripts/render-model-previews.ts --target=production",
    "generate:seo-social-cards": "node --import tsx scripts/generate-seo-social-cards.ts",
    "generate:review-model-previews": "tsx scripts/render-model-previews.ts --target=review",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:github-stars-badge": "vitest run tests/github-stars-badge-worker.test.ts",
    "test:review": "playwright test --config playwright.review.config.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:production-boundary": "tsx scripts/validate-production-boundary.ts",
    "validate:model-previews": "tsx scripts/validate-model-previews.ts --target=production",
    "validate:review-model-previews": "tsx scripts/validate-model-previews.ts --target=review",
    "validate:review": "tsx scripts/validate-review-assets.ts && npm run validate:review-model-previews",
    "generate:credits": "tsx scripts/generate-credits.ts",
    "capture:readme-screenshots": "playwright test --config playwright.readme-screenshots.config.ts",
    "deploy:github-stars-badge": "npx --yes wrangler@4.128.0 deploy --config workers/github-stars-badge/wrangler.jsonc",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/zcool-kuaile": "5.3.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.4.2",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "sharp": "0.34.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
